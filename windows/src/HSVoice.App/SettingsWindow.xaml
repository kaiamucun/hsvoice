<Window x:Class="HSVoice.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Voice 設定"
        Width="520" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" >
      <StackPanel.Resources>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="FontSize" Value="14"/>
          <Setter Property="Margin" Value="0,18,0,6"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
          <Setter Property="Foreground" Value="#FF777777"/>
          <Setter Property="FontSize" Value="11.5"/>
          <Setter Property="TextWrapping" Value="Wrap"/>
          <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
      </StackPanel.Resources>

      <TextBlock Text="話す言語" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
      <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged"/>

      <TextBlock Text="ショートカット" Style="{StaticResource SectionHeader}"/>
      <ComboBox x:Name="ShortcutBox" SelectionChanged="OnShortcutChanged"/>
      <TextBlock Style="{StaticResource Hint}"
                 Text="Windowsにはfn(地球儀)キーがないため、既定は右Ctrlです。Ctrl+Space系はIMEの切り替え設定と重なっていないか確認してください。"/>

      <TextBlock Text="録音方式" Style="{StaticResource SectionHeader}"/>
      <RadioButton x:Name="HoldRadio" Content="押している間だけ録音" GroupName="activation"
                   Checked="OnActivationChanged" Margin="0,2"/>
      <RadioButton x:Name="ToggleRadio" Content="押すたびに開始・停止" GroupName="activation"
                   Checked="OnActivationChanged" Margin="0,2"/>

      <TextBlock Text="入力方法" Style="{StaticResource SectionHeader}"/>
      <RadioButton x:Name="AutomaticRadio" Content="カーソル位置へ自動入力" GroupName="insertion"
                   Checked="OnInsertionChanged" Margin="0,2"/>
      <RadioButton x:Name="ClipboardRadio" Content="クリップボードへコピーのみ" GroupName="insertion"
                   Checked="OnInsertionChanged" Margin="0,2"/>
      <TextBlock Style="{StaticResource Hint}"
                 Text="自動入力は録音前に使っていたアプリのカーソル位置へ直接入力します(クリップボードは使いません)。管理者権限で動作中のアプリへは入力できず、コピーへ切り替わります。"/>

      <TextBlock Text="カスタム辞書(最大100語)" Style="{StaticResource SectionHeader}"/>
      <TextBox x:Name="VocabularyBox" AcceptsReturn="True" Height="88"
               TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
               LostFocus="OnVocabularyChanged"/>
      <TextBlock Style="{StaticResource Hint}"
                 Text="改行・カンマ・読点区切り。社名・製品名・人名などの表記を認識へ誘導します。"/>

      <TextBlock Text="動作" Style="{StaticResource SectionHeader}"/>
      <CheckBox x:Name="SpokenCommandsCheck" Content="音声レイアウトコマンド(「改行」「新しい段落」など)"
                Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" Margin="0,2"/>
      <CheckBox x:Name="SoundCheck" Content="開始・終了のサウンド"
                Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" Margin="0,2"/>
      <CheckBox x:Name="HistoryCheck" Content="テキスト履歴を保存する(このPCの中のみ・最大100件)"
                Checked="OnBehaviorChanged" Unchecked="OnBehaviorChanged" Margin="0,2"/>
      <CheckBox x:Name="LaunchCheck" Content="サインイン時に起動"
                Checked="OnLaunchChanged" Unchecked="OnLaunchChanged" Margin="0,2"/>
      <Button x:Name="ClearHistoryButton" Content="履歴を消去" Width="120"
              HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnClearHistory"/>

      <TextBlock Text="音声認識モデル" Style="{StaticResource SectionHeader}"/>
      <TextBlock x:Name="ModelStatus" TextWrapping="Wrap"/>
      <ProgressBar x:Name="ModelDownloadProgress" Height="8" Margin="0,8,0,0"
                   Minimum="0" Maximum="1" Visibility="Collapsed"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="DownloadModelButton" Content="推奨モデルをダウンロード" Padding="10,4"
                Click="OnDownloadModel"/>
        <Button Content="モデルファイルを選択…" Padding="10,4" Margin="8,0,0,0" Click="OnBrowseModel"/>
        <Button Content="再読み込み" Padding="10,4" Margin="8,0,0,0" Click="OnReloadModel"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Hint}"
                 Text="ggml形式のwhisperモデル(例: ggml-large-v3-turbo-q5_0.bin)。アプリフォルダまたは %APPDATA%\HS Voice\models に置くと自動検出されます。"/>

      <TextBlock Text="サポート" Style="{StaticResource SectionHeader}"/>
      <Button Content="診断情報をコピー(入力本文は含まれません)" Padding="10,4"
              HorizontalAlignment="Left" Click="OnCopyDiagnostics"/>

      <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" Margin="0,20,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
