<Window x:Class="HSVoice.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HS Voice セットアップ"
        Width="540" Height="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
  <StackPanel Margin="28">
    <TextBlock Text="HS Voice へようこそ" FontSize="22" FontWeight="SemiBold"/>
    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF555555"
               Text="キーを押して話すと、認識されたテキストがカーソル位置へ入力されます。音声はこのPCの中だけで処理され、外部へ送信されることはありません。"/>

    <TextBlock Text="1. 音声認識モデル" FontSize="14" FontWeight="SemiBold" Margin="0,24,0,6"/>
    <TextBlock x:Name="ModelStatusText" TextWrapping="Wrap"/>
    <ComboBox x:Name="ModelChoiceBox" Margin="0,8,0,0"/>
    <ProgressBar x:Name="DownloadProgress" Height="10" Margin="0,10,0,0"
                 Minimum="0" Maximum="1" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
      <Button x:Name="DownloadButton" Content="ダウンロード" Padding="14,6" Click="OnDownload"/>
      <Button x:Name="BrowseButton" Content="既にあるモデルファイルを選択…" Padding="14,6"
              Margin="8,0,0,0" Click="OnBrowse"/>
    </StackPanel>
    <TextBlock TextWrapping="Wrap" Foreground="#FF777777" FontSize="11.5" Margin="0,6,0,0"
               Text="数百MBのファイルを1回だけダウンロードします。社内配布版でモデルが同梱されている場合、この手順は自動的にスキップされます。"/>

    <TextBlock Text="2. マイク" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6"/>
    <TextBlock TextWrapping="Wrap" Foreground="#FF555555"
               Text="Windowsの「設定 → プライバシーとセキュリティ → マイク」で、デスクトップアプリのマイク使用が許可されていることを確認してください。"/>

    <TextBlock Text="3. 使い方" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,6"/>
    <TextBlock x:Name="UsageText" TextWrapping="Wrap" Foreground="#FF555555"/>

    <Button x:Name="StartButton" Content="使い始める" Padding="20,8" FontSize="14"
            HorizontalAlignment="Center" Margin="0,28,0,0" IsEnabled="False"
            Click="OnStart"/>
  </StackPanel>
</Window>
